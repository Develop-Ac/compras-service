// Régua de margem das três tabelas de preço — CONFIGURÁVEL EM DADO (US-040 / T-024).
// Uma linha por (tabela_preco, faixa de custo); intervalo MEIO-ABERTO
// [custo_min, custo_max), com custo_max = custo_min da faixa seguinte e NULL =
// infinito na última. Cobertura total por construção: nenhum custo fica sem faixa
// (AC3), inclusive custo com mais de duas casas vindo de divisão por quantidade.
// Consequência declarada: 400,00 cai em 99,01–400,00 e 400,01 já cai na regra de
// "acima de 400,00" — a mesma que vale para um custo de R$ 500,00.
//
// Versionamento append-only: alterar faixa NÃO faz UPDATE dos limites — fecha a
// linha vigente (vigencia_fim/encerrado_por/encerrado_em) e insere outra. A tabela
// é o próprio histórico auditável exigido pelo DoD ("quem alterou, quando").
//
// A não-monotonicidade entre as duas últimas faixas do varejo (110% → 150%) é
// INTENCIONAL (PRD#escopo) — não existe constraint comparando faixas vizinhas.
//
// markup_min_pct/markup_max_pct em Decimal(8,4), a MESMA precisão de
// com_fifo_completo.margem_pct (total 8, não 15 — medido na T-023): teto de
// 9999,9999%. A régua de hoje chega a 1000%, sem conflito.
//
// A UNICIDADE da faixa vigente é um índice PARCIAL
// (uq_com_precificacao_faixa_vigente ... WHERE vigencia_fim IS NULL), não
// representável no schema Prisma — vive só na DDL; aqui declara-se o índice de
// histórico. Não usar findUnique por (tabela_preco, custo_min): as linhas
// encerradas repetem a combinação.
//
// DDL aplicado MANUALMENTE (sql/2026-07-30_precificacao_faixas.sql) — rodar apenas
// `npx prisma generate` aqui.
model com_precificacao_faixa {
  id              Int       @id @default(autoincrement())
  tabela_preco    String    @db.VarChar(20)
  custo_min       Decimal   @db.Decimal(15, 2)
  custo_max       Decimal?  @db.Decimal(15, 2)
  markup_min_pct  Decimal   @db.Decimal(8, 4)
  markup_max_pct  Decimal   @db.Decimal(8, 4)
  vigencia_inicio DateTime  @db.Timestamp(6)
  vigencia_fim    DateTime? @db.Timestamp(6)
  criado_por      String    @db.VarChar(120)
  criado_em       DateTime  @default(now()) @db.Timestamp(6)
  encerrado_por   String?   @db.VarChar(120)
  encerrado_em    DateTime? @db.Timestamp(6)
  motivo          String?

  @@index([tabela_preco, vigencia_inicio], map: "idx_com_precificacao_faixa_historico")
}

// US-043 / T-030 — série histórica da taxa de exceção da triagem (insumo de M5).
//
// Grão: UMA execução da triagem de UMA nota/pedido. Reprocessar o mesmo pedido gera
// linha NOVA de propósito — a série É a sucessão das medições. Não há unique key de
// negócio: a idempotência do projeto vale para importação e fila, não para métrica.
//
// por_motivo é JSONB com a decomposição por motivo (ContagemMotivoDto[]); as chaves
// são as sete do conjunto fechado, garantidas pelo TIPO no código
// (dto/triagem-nota.dto.ts), não por constraint.
//
// DDL MANUAL (sql/2026-07-30_precificacao_triagem_execucao.sql) — ENTREGUE E AINDA
// NÃO APLICADA. Aqui rodar apenas `npx prisma generate`, nunca `prisma migrate`.
// Enquanto a DDL não for aplicada a triagem funciona por inteiro: a escrita é
// best-effort e a resposta declara a indisponibilidade da série.
model com_precificacao_triagem_execucao {
  id                    Int      @id @default(autoincrement())
  pedido_id             String   @db.VarChar(40)
  chave_nfe             String?  @db.VarChar(44)
  for_codigo            Int?
  itens                 Int
  automaticos           Int
  excecoes              Int
  taxa_excecao_pct      Decimal  @db.Decimal(7, 4)
  meta_pct              Decimal  @db.Decimal(7, 4)
  dentro_da_meta        Boolean
  excecoes_sem_proposta Int      @default(0)
  por_motivo            Json     @db.JsonB
  triado_em             DateTime @db.Timestamp(6)
  criado_em             DateTime @default(now()) @db.Timestamp(6)

  @@index([triado_em(sort: Desc)], map: "idx_com_precificacao_triagem_execucao_serie")
  @@index([pedido_id, triado_em(sort: Desc)], map: "idx_com_precificacao_triagem_execucao_pedido")
}
