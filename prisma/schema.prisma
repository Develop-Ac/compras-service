generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model sis_usuarios {
  nome               String
  senha              String
  trash              Int                @default(0)
  id                 String             @id @default(cuid())
  codigo             String             @unique
  perfil_acesso      String
  avatar_url         String?
  tema_preferencia   String             @default("system")
  setor              String?            @db.VarChar(255)
  vendas_rep_codigo  Int?
  vendas_hub_inicial String?            @db.VarChar(30)
  est_auditoria      est_auditoria[]
  est_contagem       est_contagem[]
  est_contagem_logs  est_contagem_log[]
  fed_comentarios    fed_comentarios[]
  fed_curtidas       fed_curtidas[]
  fed_eventos        fed_eventos[]
  fed_posts          fed_posts[]
  sis_permissoes     sis_permissoes[]
}

model com_cotacao {
  id                String              @id @default(cuid())
  empresa           Int
  pedido_cotacao    Int                 @unique
  indice            Int                 @unique(map: "com_cotacao_indice_unique") @default(autoincrement())
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  dias_compra       Decimal?            @db.Decimal(10, 2)
  com_cotacao_itens com_cotacao_itens[]
}

model com_cotacao_itens {
  pedido_cotacao   Int
  emissao          DateTime?
  pro_codigo       Int
  pro_descricao    String
  mar_descricao    String?
  referencia       String?
  unidade          String?
  quantidade       Int
  dt_ultima_compra DateTime?
  qtd_sugerida     Int?
  com_cotacao      com_cotacao @relation(fields: [pedido_cotacao], references: [pedido_cotacao], onDelete: Cascade)

  @@id([pedido_cotacao, pro_codigo])
}

model ofi_checklists {
  id                           String                   @id @default(cuid())
  osInterna                    String?
  dataHoraEntrada              DateTime?
  observacoes                  String?
  combustivelPercentual        Int?
  clienteNome                  String?
  clienteDoc                   String?
  clienteTel                   String?
  clienteEnd                   String?
  veiculoNome                  String?
  veiculoPlaca                 String?
  veiculoCor                   String?
  veiculoKm                    BigInt?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  assinaturasclienteBase64     String?
  assinaturasresponsavelBase64 String?
  data_hora_entrega            DateTime?                @db.Timestamp(6)
  status                       String?
  assinatura_retirada_base64   String?
  dataHoraEntrega              DateTime?
  assinaturaRetiradaBase64     String?
  ofi_checklists_avarias       ofi_checklists_avarias[]
  ofi_checklists_fotos         ofi_checklists_fotos[]
  ofi_checklists_items         ofi_checklists_items[]

  @@index([data_hora_entrega], map: "idx_ofi_checklists_data_hora_entrega")
  @@index([status, data_hora_entrega], map: "idx_ofi_checklists_status_entrega")
}

model ofi_checklists_avarias {
  id             String         @id @default(cuid())
  checklistId    String
  tipo           String?
  peca           String?
  observacoes    String?
  posX           Float?
  posY           Float?
  posZ           Float?
  normX          Float?
  normY          Float?
  normZ          Float?
  fotoBase64     String?
  timestamp      DateTime?
  ofi_checklists ofi_checklists @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
}

model ofi_checklists_items {
  id             String         @id @default(cuid())
  checklistId    String
  item           String
  status         String
  ofi_checklists ofi_checklists @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
}

model com_cotacao_for {
  id             String                  @id @default(cuid())
  empresa        Int                     @default(3)
  pedido_cotacao Int
  for_codigo     Int
  for_nome       String?
  cpf_cnpj       String?
  created_at     DateTime                @default(now())
  updated_at     DateTime                @updatedAt
  trash          Int?                    @default(0)
  itens          com_cotacao_itens_for[]

  @@unique([pedido_cotacao, for_codigo], name: "pedido_for")
  @@index([pedido_cotacao])
}

model com_cotacao_itens_for {
  id             String          @id @default(cuid())
  pedido_cotacao Int
  for_codigo     Int
  emissao        DateTime?
  pro_codigo     Int
  pro_descricao  String
  mar_descricao  String?
  referencia     String?
  unidade        String?
  quantidade     Int
  valor_unitario Float?
  qtd_sugerida   Int?            @default(0)
  ref_fornecedor String?         @db.VarChar(255)
  cotacao        com_cotacao_for @relation(fields: [pedido_cotacao, for_codigo], references: [pedido_cotacao, for_codigo], onDelete: Cascade)

  @@index([pedido_cotacao, for_codigo])
}

model com_pedido {
  id             String             @id @default(cuid())
  pedido_cotacao Int
  for_codigo     Int
  created_at     DateTime           @default(now())
  updated_at     DateTime           @updatedAt
  frete          Decimal?           @db.Decimal(10, 2)
  prazo          String?            @db.VarChar(100)
  nomeFrete      String?            @db.VarChar(255)
  status         String?            @db.VarChar(50)
  categoriaFrete String?            @db.VarChar(255)
  data_recebimento DateTime?
  // Quando true, o valor unitário do pedido já inclui o IPI; a conferência soma
  // o IPI por unidade da NF ao valor faturado antes de comparar (evita divergência).
  ipi_no_valor   Boolean            @default(false)
  // Status do pedido antes de virar 'Vínculo sugerido'; usado para reverter ao
  // rejeitar a sugestão (volta a ser elegível ao auto-vínculo de outras NFs).
  status_anterior String?           @db.VarChar(50)
  // Resumo de GARANTIA do fornecedor do pedido (contas a receber IC/RET em
  // aberto). Persistido para a listagem/aviso; o detalhe é recomputado ao vivo
  // na aba Garantia. Preenchido ao gerar/salvar o pedido e pelo seed. DDL manual.
  tem_garantia           Boolean   @default(false)
  garantia_qtd_titulos   Int?
  garantia_qtd_produtos  Int?
  garantia_valor         Decimal?  @db.Decimal(15, 2)
  garantia_verificada_em DateTime?
  itens          com_pedido_itens[]
  nfe_vinculos   com_pedido_nfe_vinculo[]

  @@unique([pedido_cotacao, for_codigo])
  @@index([pedido_cotacao])
  @@index([for_codigo])
}

model com_pedido_itens {
  id               String     @id @default(cuid())
  pedido_id        String
  item_id_origem   String?
  pro_codigo       Int
  pro_descricao    String
  mar_descricao    String?
  referencia       String?
  unidade          String?
  emissao          DateTime?
  valor_unitario   Decimal?
  custo_fabrica    Decimal?
  preco_custo      Decimal?
  for_codigo       Int
  quantidade       Decimal
  created_at       DateTime   @default(now())
  renato           Boolean?   @default(false)
  carlos           Boolean?   @default(false)
  justificativa    String?    @db.VarChar(100)
  qtd_sugerida_min Decimal?   @db.Decimal(15, 4)
  qtd_sugerida_max Decimal?   @db.Decimal(15, 4)
  // Status manual do item no fechamento do pedido. NULL = pendente/normal (fluxo
  // atual). 'nao_atendido' = "Não Atendido pelo Fornecedor": item baixado pelo
  // comprador (fornecedor SEM carteira) — deixa de travar o status do pedido e
  // deixa de marcar "produto já em pedido" na nova cotação. DDL manual.
  status_item      String?    @db.VarChar(30)
  status_item_por  String?    @db.VarChar(120)
  status_item_em   DateTime?
  pedido           com_pedido @relation(fields: [pedido_id], references: [id], onDelete: Cascade)

  @@unique([pedido_id, pro_codigo, for_codigo])
  @@index([pedido_id])
  @@index([pedido_id, pro_codigo, for_codigo], map: "idx_com_pedido_itens_pedido_produto_sug")
}

model com_pedido_nfe_vinculo {
  id              String     @id @default(cuid())
  pedido_id       String     // FK com_pedido.id (contexto da tela do pedido)
  pedido_cotacao  Int
  for_codigo      Int?
  chave_nfe       String     @db.VarChar(44)
  emitente        String?
  data_emissao    DateTime?
  valor_total     Decimal?   @db.Decimal(15, 2)
  usuario         String?    @db.VarChar(120)
  confirmado      Boolean    @default(true)
  // Sugestão automática rejeitada pelo usuário: a linha é mantida (não apagada)
  // para que o auto-vínculo NÃO sugira a mesma NF p/ este pedido de novo.
  rejeitado       Boolean    @default(false)
  origem_vinculo  String     @default("manual") @db.VarChar(20)
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt
  pedido          com_pedido @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  itens           com_pedido_nfe_vinculo_item[]

  @@unique([pedido_id, chave_nfe])
  @@index([pedido_id])
  @@index([chave_nfe])
}

model com_pedido_nfe_vinculo_item {
  id                  String   @id @default(cuid())
  vinculo_id          String
  tipo                String   @db.VarChar(20) // 'vinculado' | 'xml_sem_vinculo' | 'pedido_sem_vinculo'
  // dados do lado XML
  produto_xml         String?
  cprod_xml           String?
  quantidade_xml      Decimal? @db.Decimal(15, 4)
  vuncom_xml          Decimal? @db.Decimal(15, 4)
  // dados do lado pedido/cotação
  pro_codigo          Int?
  pro_descricao       String?
  quantidade_cotacao  Decimal? @db.Decimal(15, 4)
  quantidade_pedido   Decimal? @db.Decimal(15, 4)
  valor_pedido        Decimal? @db.Decimal(15, 4)
  // saldo: quanto DESTE pedido foi alocado do item da NF (quantidade_xml = qCom total, informativo)
  quantidade_alocada  Decimal? @db.Decimal(15, 4)
  excede_saldo        Boolean  @default(false)
  // metadados do casamento
  match_campo         String?  @db.VarChar(60)
  match_valor         String?
  origem              String?  @db.VarChar(20) // 'auto' | 'manual'
  created_at          DateTime @default(now())
  vinculo             com_pedido_nfe_vinculo @relation(fields: [vinculo_id], references: [id], onDelete: Cascade)

  @@index([vinculo_id])
}

/// Snapshot do total de cada item de uma NF-e (semeado do XML na 1ª vinculação).
/// Serve para esconder "NF sem saldo" na listagem sem reparsear o XML. O consumido
/// é sempre calculado ao vivo dos vínculos confirmados (com_pedido_nfe_vinculo_item).
model com_nfe_saldo_item {
  id         String   @id @default(cuid())
  chave_nfe  String   @db.VarChar(44)
  cprod      String
  descricao  String?
  qtd_total  Decimal  @db.Decimal(15, 4)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([chave_nfe, cprod])
  @@index([chave_nfe])
}

model est_contagem {
  id                String             @id @default(cuid())
  colaborador       String
  created_at        DateTime           @default(now())
  contagem          Int                @default(1)
  liberado_contagem Boolean            @default(false)
  contagem_cuid     String?
  piso              String?            @db.VarChar
  status            Int                @default(0)
  tipo              Int                @default(1)
  usuario           sis_usuarios       @relation(fields: [colaborador], references: [id])
  logs              est_contagem_log[]

  @@index([colaborador])
  @@index([contagem_cuid])
}

model est_contagem_itens {
  id                 String             @id @default(cuid())
  data               DateTime
  cod_produto        Int
  desc_produto       String
  mar_descricao      String?
  ref_fabricante     String?
  ref_fornecedor     String?
  localizacao        String?
  unidade            String?
  qtde_saida         Int
  estoque            Int
  reserva            Int
  conferir           Boolean            @default(true)
  contagem_cuid      String
  aplicacoes         String?
  identificador_item String?            @db.VarChar
  logs               est_contagem_log[]

  @@index([contagem_cuid])
  @@index([cod_produto])
}

model est_contagem_log {
  id                 String             @id @default(cuid())
  contagem_id        String
  usuario_id         String
  item_id            String
  estoque            Int
  contado            Int
  created_at         DateTime           @default(now())
  identificador_item String?            @db.VarChar
  contagem           est_contagem       @relation(fields: [contagem_id], references: [id])
  item               est_contagem_itens @relation(fields: [item_id], references: [id])
  usuario            sis_usuarios       @relation(fields: [usuario_id], references: [id])

  @@index([contagem_id])
  @@index([usuario_id])
  @@index([item_id])
}

model com_data_saldo_produto {
  id             Int       @id @default(autoincrement())
  pro_codigo     String?   @db.VarChar(50)
  data_compra    DateTime? @db.Date
  saldo_residual Decimal?  @db.Decimal(15, 4)
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  @@index([pro_codigo], map: "idx_saldo_prod_codigo")
}

model com_fifo_completo {
  id                         Int       @id @default(autoincrement())
  data_processamento         DateTime? @default(now()) @db.Timestamp(6)
  pro_codigo                 String?   @db.VarChar(50)
  tempo_medio_estoque        Decimal?  @db.Decimal(15, 4)
  qtd_vendida                Decimal?  @db.Decimal(15, 4)
  valor_vendido              Decimal?  @db.Decimal(15, 4)
  data_min_venda             DateTime? @db.Date
  data_max_venda             DateTime? @db.Date
  periodo_dias               Int?
  demanda_media_dia          Decimal?  @db.Decimal(15, 6)
  num_vendas                 Int?
  vendas_ult_12m             Decimal?  @db.Decimal(15, 4)
  vendas_12m_ant             Decimal?  @db.Decimal(15, 4)
  fator_tendencia            Decimal?  @db.Decimal(10, 6)
  tendencia_label            String?   @db.VarChar(20)
  dias_ruptura               Int?
  demanda_media_dia_ajustada Decimal?  @db.Decimal(15, 6)
  pro_descricao              String?
  estoque_disponivel         Decimal?  @db.Decimal(15, 4)
  mar_descricao              String?   @db.VarChar(100)
  fornecedor1                String?   @db.VarChar(200)
  fornecedor2                String?   @db.VarChar(200)
  fornecedor3                String?   @db.VarChar(200)
  pct_acum_valor             Decimal?  @db.Decimal(10, 4)
  curva_abc                  String?   @db.VarChar(10)
  categoria_estocagem        String?   @db.VarChar(20)
  estoque_min_base           Int?
  estoque_max_base           Int?
  fator_ajuste_tendencia     Decimal?  @db.Decimal(10, 6)
  estoque_min_ajustado       Int?
  estoque_max_ajustado       Int?
  estoque_min_sugerido       Int?
  estoque_max_sugerido       Int?
  tipo_planejamento          String?   @db.VarChar(30)
  alerta_tendencia_alta      String?   @db.VarChar(10)
  descricao_calculo_estoque  String?
  created_at                 DateTime? @default(now()) @db.Timestamp(6)
  sgr_codigo                 Int?
  teve_alteracao_analise     Boolean?  @default(false)
  dados_alteracao_json       String?
  sgr_descricao              String?   @db.VarChar(200)
  group_id                   String?   @db.VarChar(100)
  grp_estoque_disponivel     Decimal?  @db.Decimal(15, 4)
  grp_qtd_vendida            Decimal?  @db.Decimal(15, 4)
  grp_valor_vendido          Decimal?  @db.Decimal(15, 4)
  grp_num_vendas             Int?
  grp_vendas_ult_12m         Decimal?  @db.Decimal(15, 4)
  grp_vendas_12m_ant         Decimal?  @db.Decimal(15, 4)
  grp_estoque_min_base       Int?
  grp_estoque_max_base       Int?
  grp_estoque_min_ajustado   Int?
  grp_estoque_max_ajustado   Int?
  grp_estoque_min_sugerido   Int?
  grp_estoque_max_sugerido   Int?
  grp_demanda_media_dia      Decimal?  @db.Decimal(15, 6)
  rateio_prop_grupo          Decimal?  @db.Decimal(10, 6)
  tempo_medio_saldo_atual    Decimal?  @db.Decimal(15, 2)
  categoria_saldo_atual      String?   @db.VarChar(50)
  pro_referencia             String?

  // Colunas materializadas pelo ETL do analise-estoque-service (dono da escrita desta
  // tabela) e consumidas pelo modulo de precificacao (O6 / EP-012). Ja existiam no banco;
  // faltavam apenas na declaracao Prisma deste servico, o que quebrava o build no CI
  // (o client local havia sido gerado de uma versao do schema que as declarava).
  // Somente leitura: este servico nunca escreve em com_fifo_completo.
  grupo_chave                String?   @db.VarChar(255)
  grupo_qtd_itens            Int?
  demanda_planejamento_dia   Decimal?  @db.Decimal(15, 6)
  grupo_demanda_dia          Decimal?  @db.Decimal(15, 6)
  preco_venda_1              Decimal?  @db.Decimal(15, 4)
  preco_venda_2              Decimal?  @db.Decimal(15, 4)

  // Colunas de CUSTO/MARGEM materializadas pelo ETL do analise-estoque-service (dono da
  // escrita desta tabela). DDL manual em `sql/2026-07-29_custo_fifo.sql` daquele servico —
  // as tres ultimas nasceram ali; `custo_unitario`, `margem_unitaria` e `margem_pct` sao
  // anteriores e o script apenas as recomentou por mudanca de semantica. Ja existiam no
  // banco; faltavam na declaracao Prisma deste servico. Tipos conferidos em
  // `information_schema.columns` (2026-07-29) — nao inferidos.
  // Somente leitura: este servico nunca escreve em com_fifo_completo.
  //
  // Semantica corrigida em 2026-07-29 (DATA_MODEL#semantica-do-custo-em-com_fifo_completo):
  // - custo_unitario: custo FIFO do estoque VIVO (media ponderada por qtd das camadas
  //   residuais). Ate 2026-07-29 continha o custo medio das vendas 12m, hoje em
  //   custo_cogs_12m. **NULL e ausencia de custo no ERP, nunca "de graca"** — 6.975
  //   produtos passaram de 0,00 para NULL; consumidor precisa tratar NULL.
  // - margem_unitaria / margem_pct: margem PROSPECTIVA (preco realizado 12m - custo do
  //   estoque hoje). A base retrospectiva antiga vive em margem_unitaria_realizada.
  // - custo_cogs_12m: custo medio ponderado do que FOI VENDIDO em 12m (COGS/qtd) — base da
  //   margem realizada; nao e o custo do estoque.
  // - custo_fonte: degrau da cadeia de custo (`camada_viva` | `ultima_entrada` | `cadastro`
  //   | NULL) — sinal de confiabilidade do custo.
  // - margem_unitaria_realizada: preco realizado 12m - custo_cogs_12m (base antiga de
  //   margem_unitaria).
  custo_unitario             Decimal?  @db.Decimal(15, 4)
  margem_unitaria            Decimal?  @db.Decimal(15, 4)
  margem_pct                 Decimal?  @db.Decimal(8, 4)
  custo_cogs_12m             Decimal?  @db.Decimal(15, 4)
  custo_fonte                String?   @db.VarChar(20)
  margem_unitaria_realizada  Decimal?  @db.Decimal(15, 4)

  @@index([teve_alteracao_analise], map: "idx_com_fifo_alteracao")
  @@index([categoria_estocagem], map: "idx_com_fifo_categoria_estocagem")
  @@index([categoria_saldo_atual], map: "idx_com_fifo_categoria_saldo_atual")
  @@index([curva_abc], map: "idx_com_fifo_curva_abc")
  @@index([data_processamento], map: "idx_com_fifo_data_processamento")
  @@index([group_id], map: "idx_com_fifo_group_id")
  @@index([pro_codigo], map: "idx_com_fifo_pro_codigo")
}

model com_kanban {
  id        String   @id
  data      Json
  updatedAt DateTime
  createdAt DateTime @default(now())
}

model com_metricas_fifo {
  pro_codigo                Int       @id(map: "pk_metricas_estoque_fifo")
  tempo_medio_estoque       Decimal?  @db.Decimal(18, 6)
  qtd_vendida               Int?
  valor_vendido             Decimal?  @db.Decimal(18, 2)
  data_min_venda            DateTime? @db.Timestamp(6)
  data_max_venda            DateTime? @db.Timestamp(6)
  periodo_dias              Int?
  demanda_media_dia         Decimal?  @db.Decimal(18, 6)
  num_vendas                Int?
  vendas_ult_12m            Int?
  vendas_12m_ant            Int?
  fator_tendencia           Decimal?  @db.Decimal(18, 6)
  tendencia_label           String?   @db.VarChar(20)
  pro_descricao             String?   @db.VarChar(255)
  estoque_disponivel        Decimal?  @db.Decimal(18, 3)
  mar_descricao             String?   @db.VarChar(100)
  fornecedor1               String?   @db.VarChar(150)
  fornecedor2               String?   @db.VarChar(150)
  fornecedor3               String?   @db.VarChar(150)
  pct_acum_valor            Decimal?  @db.Decimal(18, 6)
  curva_abc                 String?   @db.Char(1)
  categoria_estocagem       String?   @db.VarChar(20)
  estoque_min_base          Int?
  estoque_max_base          Int?
  fator_ajuste_tendencia    Decimal?  @db.Decimal(18, 6)
  estoque_min_ajustado      Int?
  estoque_max_ajustado      Int?
  estoque_min_sugerido      Int?
  estoque_max_sugerido      Int?
  tipo_planejamento         String?   @db.VarChar(30)
  alerta_tendencia_alta     String?   @db.VarChar(3)
  descricao_calculo_estoque String?
}

model com_nfe_conciliacao {
  chave_nfe                String                     @id
  emitente                 String
  cnpj_emitente            String?
  data_emissao             DateTime
  valor_total              Float
  xml_completo             String?
  status_analise           String                     @default("Tributado - Verificado")
  valor_guia               Float                      @default(0.0)
  status_erp               String                     @default("PENDENTE")
  dt_entrada               DateTime?
  updated_at               DateTime
  created_at               DateTime                   @default(now())
  tipo_operacao            Int                        @default(0)
  tipo_operacao_desc       String                     @default("ENTRADA PRÓPRIA")
  tipo_imposto             String?                    @db.VarChar(50)
  compra_comercializacao   Boolean                    @default(false)
  uso_consumo              Boolean                    @default(false)
  com_nfe_conciliacao_item com_nfe_conciliacao_item[]
}

model com_pagamento_guia {
  chave_nfe      String   @id
  data_pagamento DateTime @default(now())
  valor          Float    @default(0.0)
  observacoes    String   @default("")
}

model com_relacionamento_itens {
  id         Int       @id @default(autoincrement())
  group_id   String    @db.VarChar(100)
  pro_codigo String    @unique @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([group_id], map: "idx_rel_group_id")
