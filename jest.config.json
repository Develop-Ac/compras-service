{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "roots": ["<rootDir>/src", "<rootDir>/test"],
  "testRegex": ".*\\.(spec|int-spec)\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", {
      "tsconfig": {
        "types": ["jest", "node"]
      }
    }]
  },
  "collectCoverageFrom": [
    "src/**/*.(t|j)s",
    "!**/*.spec.ts",
    "!**/*.int-spec.ts",
    "!**/*.interface.ts",
    "!**/*.dto.ts",
    "!**/*.types.ts",
    "!**/main.ts"
  ],
  "coverageDirectory": "<rootDir>/coverage",
  "testEnvironment": "node",
  "setupFilesAfterEnv": ["<rootDir>/test/setup.ts"],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  }
}
